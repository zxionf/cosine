{
  "scopeName": "source.xel",
  "name": "xel",
  "fileTypes": ["xel", "xel"],
  "patterns": [
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "keywords": {
      "patterns": [{
        "name": "keyword.control.xel",
        "match": "\\b(if|else|while|for|return|;)\\b"
      }, {
        "name": "keyword.declaration.xel",
        "match": "\\b(var|fun|class)\\b"
      }, {
        "name": "keyword.import.xel",
        "match": "\\b(import|export|from|as)\\b"
      },
      {
        "name": "keyword.operator.xel",
        "match": "\\b(and|or|[+\\-*/%=<>!&|^~])\\b"
      },
      {
        "name": "keyword.other.xel",
        "match": "\\b(print)\\b"
      }]
    },
    "types": {
      "name": "storage.type.xel",
      "match": "\\b(int|float|double|string|bool|boolean|void|any|array|map|set|object)\\b"
    },
    "constants": {
      "name": "constant.language.xel",
      "match": "\\b(true|false|nil)\\b"
    },
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.xel",
        "match": "//.*$"
      }, {
        "name": "comment.block.xel",
        "begin": "/\\*",
        "end": "\\*/"
      }]
    },
    "strings": {
      "name": "string.quoted.double.xel",
      "begin": "\"",
      "end": "\"",
      "patterns": [{
        "name": "constant.character.escape.xel",
        "match": "\\\\."
      }]
    },
    "numbers": {
      "name": "constant.numeric.xel",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "identifier": {
      "name": "entity.name.xel",
      "match": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  }
}